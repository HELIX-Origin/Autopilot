# ==============================================================================
# Autopilot Plugin for OpenCode - Git Ignore Policy
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs (Compiled from src/)
lib/
dist/
build/
out/
*.tsbuildinfo

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Credentials
.env
.env.local
.env.*.local
*.env

# Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE & Editor Settings
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test Artifacts & Coverage
coverage/
.nyc_output/

# Temporary / Scratch Files
*.tmp
*.bak
scratch/

# OpenCode trash
.opencode_trash/
